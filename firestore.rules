rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Catch-All Default Deny Rule (Required)
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    function isAuthorizedTrainingAdmin() {
      return isAdmin() && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Owner' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'TrainingManager' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Trainer'
      );
    }

    function isAuthorizedCommunityReviewer() {
      return isAdmin() && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Owner' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'CitizenModerator' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'ContentEditor' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'LibraryCurator' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'RightsReviewer' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'TrainingManager'
      );
    }

    function isCanonicalCitizenSubmissionShape() {
      return request.resource.data.keys().hasAll([
          'id', 'submittedAt', 'submittedByUid', 'contributorName',
          'title', 'body', 'sourceLanguage', 'category',
          'status', 'attachments', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'submittedAt', 'submittedByUid', 'contributorName', 'contributorContact',
          'title', 'body', 'sourceLanguage', 'category', 'locationDescription',
          'status', 'attachments', 'editorialReferenceId', 'moderatorNotes',
          'reviewedByUid', 'reviewedByName', 'updatedAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedByUid is string
        && request.resource.data.contributorName is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && (request.resource.data.sourceLanguage == 'ar' || request.resource.data.sourceLanguage == 'en')
        && (request.resource.data.category in ['water', 'climate', 'desertification', 'marine'])
        && (request.resource.data.status in ['Received', 'UnderReview', 'AcceptedForEditorial', 'Rejected'])
        && request.resource.data.attachments is list
        && request.resource.data.updatedAt is string;
    }

    function isCanonicalAccountShape() {
      return request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.id is string
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function isCanonicalTrainingCourseShape() {
      return request.resource.data.keys().hasAll([
          'id', 'titleAr', 'titleEn', 'summaryAr', 'summaryEn', 'category',
          'level', 'durationHours', 'deliveryMode', 'targetAudienceAr',
          'targetAudienceEn', 'workflowState', 'workflowHistory',
          'createdAt', 'updatedAt', 'author', 'language'
        ])
        && request.resource.data.id is string
        && request.resource.data.titleAr is string
        && request.resource.data.titleEn is string
        && request.resource.data.summaryAr is string
        && request.resource.data.summaryEn is string
        && request.resource.data.category is string
        && request.resource.data.level is string
        && request.resource.data.durationHours is number
        && request.resource.data.deliveryMode is string
        && request.resource.data.targetAudienceAr is string
        && request.resource.data.targetAudienceEn is string
        && request.resource.data.workflowState is string
        && request.resource.data.workflowHistory is list
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.author is string
        && request.resource.data.language is string;
    }

    function isCanonicalEnrollmentShape() {
      return request.resource.data.keys().hasOnly(['id', 'accountId', 'courseId', 'createdAt'])
        && request.resource.data.id is string
        && request.resource.data.accountId is string
        && request.resource.data.courseId is string
        && request.resource.data.createdAt is string;
    }

    function isPublishedCourse(courseId) {
      return exists(/databases/$(database)/documents/training_courses/$(courseId))
        && get(/databases/$(database)/documents/training_courses/$(courseId)).data.workflowState == 'Published';
    }

    // Admins Collection Rules Block
    match /admins/{adminId} {
      // Allow administrators to retrieve their own canonical profile
      allow get: if isOwner(adminId);
      
      // Prevent any arbitrary client creations, updates, or deletions (Fail-Closed System-Only)
      allow create, update, delete: if false;
    }

    // Accounts Collection Rules Block
    match /accounts/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.id == userId
        && isCanonicalAccountShape();
      allow update: if isOwner(userId) 
        && request.resource.data.id == userId
        && request.resource.data.id == resource.data.id
        && isCanonicalAccountShape();
      allow delete: if false;
    }

    // Training Courses Collection Rules Block
    match /training_courses/{courseId} {
      // Public read allowed ONLY for Published courses
      // Admins can read all courses (including Draft, InReview, etc.)
      allow get, list: if (resource.data.workflowState == 'Published') || isAdmin();

      // Administrative write operations require admin identity
      allow create: if isAuthorizedTrainingAdmin()
        && request.resource.data.id == courseId
        && isCanonicalTrainingCourseShape();

      allow update: if isAuthorizedTrainingAdmin()
        && request.resource.data.id == courseId
        && request.resource.data.id == resource.data.id
        && isCanonicalTrainingCourseShape();

      allow delete: if false;
    }

    // Enrollments Collection Rules Block
    match /enrollments/{enrollmentId} {
      // Authenticated owner can read their own enrollment
      allow get: if isSignedIn() && resource.data.accountId == request.auth.uid;
      allow list: if isSignedIn() && request.auth.uid == resource.data.accountId;

      // Authenticated owner can create their own enrollment ONLY for Published courses
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && request.auth.uid == request.resource.data.accountId
        && enrollmentId == request.resource.data.accountId + '_' + request.resource.data.courseId
        && request.resource.data.id == enrollmentId
        && isCanonicalEnrollmentShape()
        && isPublishedCourse(request.resource.data.courseId);

      // Immutable relationship: client updates and deletes are denied
      allow update, delete: if false;
    }

    // Platform Settings Collection Rules Block
    match /platform_settings/{settingId} {
      // Public read allowed ONLY for canonical global settings document
      allow get: if settingId == 'global';
      allow list: if false;

      // Client mutations strictly forbidden (all mutations occur via Admin SDK callable)
      allow create, update, delete: if false;
    }

    // Canonical Media Collection Rules Block
    match /media/{mediaId} {
      // Public read allowed ONLY for Published, Approved, Rights-Cleared videos not marked Hidden
      // Administrators can inspect all items
      allow get, list: if (
        resource.data.status == 'Published' &&
        resource.data.approvalStatus == 'Approved' &&
        resource.data.rightsStatus == 'Cleared' &&
        resource.data.visibilityDecision != 'Hidden'
      ) || isAdmin();

      // Client mutations strictly denied (handled by server callable / admin SDK)
      allow create, update, delete: if false;
    }

    // Canonical Playlists Collection Rules Block
    match /playlists/{playlistId} {
      // Public read allowed for Published playlists
      allow get, list: if (resource.data.status == 'Published') || isAdmin();

      // Client mutations strictly denied (handled by server callable / admin SDK)
      allow create, update, delete: if false;
    }

    // Canonical Citizen Journalism Submissions Collection Rules Block
    match /citizen_submissions/{submissionId} {
      // Contributor can only read their own submission; active Admins can read all submissions
      allow get, list: if (isSignedIn() && resource.data.submittedByUid == request.auth.uid) || isAdmin();

      // Authenticated citizen with a provisioned canonical Account can create a new submission in Received status
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && request.resource.data.id == submissionId
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'Received'
        && !('moderatorNotes' in request.resource.data)
        && !('editorialReferenceId' in request.resource.data)
        && !('reviewedByUid' in request.resource.data)
        && !('reviewedByName' in request.resource.data)
        && isCanonicalCitizenSubmissionShape();

      // Only authorized community reviewers can update moderation status/notes; ownership & timestamps are immutable
      allow update: if isAuthorizedCommunityReviewer()
        && request.resource.data.id == submissionId
        && request.resource.data.id == resource.data.id
        && request.resource.data.submittedByUid == resource.data.submittedByUid
        && request.resource.data.submittedAt == resource.data.submittedAt
        && isCanonicalCitizenSubmissionShape();

      allow delete: if false;
    }
  }
}


