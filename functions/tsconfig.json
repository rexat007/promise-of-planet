{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "rootDir": ".."
  },
  "compileOnSave": true,
  "include": ["src"]
}
